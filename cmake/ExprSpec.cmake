file(READ "${CMAKE_CURRENT_SOURCE_DIR}/expr-spec.json" RCLI_EXPR_SPEC_JSON)
string(SHA256 RCLI_EXPR_SPEC_SHA256 "${RCLI_EXPR_SPEC_JSON}")
string(JSON function_count LENGTH "${RCLI_EXPR_SPEC_JSON}" functions)
set(RCLI_EXPR_FN_ENTRIES "")
set(RCLI_EXPR_ARITY_ENTRIES "")
set(RCLI_EXPR_FUNCTION_NAMES "")
if(function_count GREATER 0)
  math(EXPR function_last "${function_count} - 1")
  foreach(index RANGE 0 ${function_last})
    string(JSON function_name MEMBER "${RCLI_EXPR_SPEC_JSON}" functions ${index})
    string(JSON function_arity GET "${RCLI_EXPR_SPEC_JSON}" functions "${function_name}" arity)
    string(JSON function_binding GET "${RCLI_EXPR_SPEC_JSON}" functions "${function_name}" r)
    if(function_name MATCHES "^[a-z][a-z0-9_]*$")
      set(r_name "${function_name}")
    else()
      set(r_name "`${function_name}`")
    endif()
    if(RCLI_EXPR_FN_ENTRIES)
      string(APPEND RCLI_EXPR_FN_ENTRIES ",")
      string(APPEND RCLI_EXPR_ARITY_ENTRIES ",")
    endif()
    if(RCLI_EXPR_FUNCTION_NAMES)
      string(APPEND RCLI_EXPR_FUNCTION_NAMES ",")
    endif()
    string(APPEND RCLI_EXPR_FUNCTION_NAMES "'${function_name}'")
    string(APPEND RCLI_EXPR_FN_ENTRIES "${r_name}=${function_binding}")
    string(APPEND RCLI_EXPR_ARITY_ENTRIES "${r_name}=${function_arity}L")
  endforeach()
endif()
string(JSON operator_count LENGTH "${RCLI_EXPR_SPEC_JSON}" operators)
set(RCLI_EXPR_OPERATOR_NAMES "")
if(operator_count GREATER 0)
  math(EXPR operator_last "${operator_count} - 1")
  foreach(index RANGE 0 ${operator_last})
    string(JSON operator_name GET "${RCLI_EXPR_SPEC_JSON}" operators ${index})
    if(RCLI_EXPR_OPERATOR_NAMES)
      string(APPEND RCLI_EXPR_OPERATOR_NAMES ",")
    endif()
    string(APPEND RCLI_EXPR_OPERATOR_NAMES "'${operator_name}'")
    if(RCLI_EXPR_FN_ENTRIES)
      string(APPEND RCLI_EXPR_FN_ENTRIES ",")
      string(APPEND RCLI_EXPR_ARITY_ENTRIES ",")
    endif()
    string(APPEND RCLI_EXPR_FN_ENTRIES "`${operator_name}`=base::`${operator_name}`")
    string(APPEND RCLI_EXPR_ARITY_ENTRIES "`${operator_name}`=2L")
  endforeach()
endif()
string(JSON const_pi GET "${RCLI_EXPR_SPEC_JSON}" constants pi)
string(JSON const_e GET "${RCLI_EXPR_SPEC_JSON}" constants e)
string(JSON reserved_count LENGTH "${RCLI_EXPR_SPEC_JSON}" reserved)
set(RCLI_EXPR_RESERVED_NAMES "")
if(reserved_count GREATER 0)
  math(EXPR reserved_last "${reserved_count} - 1")
  foreach(index RANGE 0 ${reserved_last})
    string(JSON reserved_name GET "${RCLI_EXPR_SPEC_JSON}" reserved ${index})
    if(RCLI_EXPR_RESERVED_NAMES)
      string(APPEND RCLI_EXPR_RESERVED_NAMES ",")
    endif()
    string(APPEND RCLI_EXPR_RESERVED_NAMES "'${reserved_name}'")
  endforeach()
endif()
string(JSON cap_bytes GET "${RCLI_EXPR_SPEC_JSON}" caps bytes)
string(JSON cap_tokens GET "${RCLI_EXPR_SPEC_JSON}" caps tokens)
string(JSON cap_nodes GET "${RCLI_EXPR_SPEC_JSON}" caps nodes)
string(JSON cap_depth GET "${RCLI_EXPR_SPEC_JSON}" caps depth)
string(JSON cap_calls GET "${RCLI_EXPR_SPEC_JSON}" caps calls)
string(JSON cap_idents GET "${RCLI_EXPR_SPEC_JSON}" caps idents)
set(RCLI_EXPR_PRELUDE "EXPR_SPEC_SHA256 <- \"${RCLI_EXPR_SPEC_SHA256}\"\nFN <- list(${RCLI_EXPR_FN_ENTRIES})\nARITY <- c(${RCLI_EXPR_ARITY_ENTRIES})\nEXPR_FUNCTIONS <- c(${RCLI_EXPR_FUNCTION_NAMES})\nEXPR_OPERATORS <- c(${RCLI_EXPR_OPERATOR_NAMES})\nEXPR_CONST <- c(pi=${const_pi},e=${const_e})\nEXPR_RESERVED <- c(${RCLI_EXPR_RESERVED_NAMES})\nEXPR_CAPS <- c(bytes=${cap_bytes}L,tokens=${cap_tokens}L,nodes=${cap_nodes}L,depth=${cap_depth}L,calls=${cap_calls}L,idents=${cap_idents}L)")
