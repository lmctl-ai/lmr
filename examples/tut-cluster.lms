// access: read
// Topic: k-means and hierarchical clustering with recovery scoring (after: R ?kmeans, ?hclust, ?cutree; scikit-learn
//   clustering guide)
// What it does: draws three Gaussian clusters with known centres (rng_draw), runs cluster_kmeans (Hartigan-Wong, 10
//   restarts) and cluster_hclust (complete linkage, cut at 3), prints sizes, centres and the confusion of each method
//   against the true labels, and checks purity, centre recovery, the within-SS against the generating variance and the
//   dendrogram's last-merge gap.
// Data: 3 x 40 points in the plane, centres (0,0), (6,0), (3,5), isotropic sd 0.8 (seeds 441..446).
// Usage: export PATH="$PWD/bin:$PATH"; lmscript examples/tut-cluster.lms
import "../cli.schema.dev.json" as rcli;

centres = [[0, 0], [6, 0], [3, 5]]; m = 40; sd = 0.8; k = 3;
a = []; b = []; truth = [];
for (g = 0; g < k; g = g + 1) {
  da = rcli.rng_draw({dist: "norm", n: m, mean: centres[g][0], sd: sd, seed: 441 + 2 * g});
  if (da.status == "simulated") { println("clustering simulated."); exit(0); }
  db = rcli.rng_draw({dist: "norm", n: m, mean: centres[g][1], sd: sd, seed: 442 + 2 * g});
  if (da.status != "ok" || db.status != "ok") { println("rng_draw failed"); exit(1); }
  a = concat(a, da.result.value); b = concat(b, db.result.value);
  for (i = 0; i < m; i = i + 1) { truth = concat(truth, [g]); }
}
n = len(a);
km = rcli.cluster_kmeans({data: {a: a, b: b}, k: k, seed: 7, nstart: 10});
hc = rcli.cluster_hclust({data: {a: a, b: b}, method: "complete", cut_k: k});
if (km.status != "ok" || hc.status != "ok") { println("clustering failed:", json_stringify(km), json_stringify(hc)); exit(1); }

// Purity: for each true group, the share of its points carrying that group's most common label.
function purity(labels) {
  hits = 0;
  for (g = 0; g < k; g = g + 1) {
    best = 0;
    for (label in unique(labels)) {
      count = 0;
      for (i = 0; i < n; i = i + 1) { if (truth[i] == g && labels[i] == label) { count = count + 1; } }
      if (count > best) { best = count; }
    }
    hits = hits + best;
  }
  return hits / n;
}
pk = purity(km.result.cluster); ph = purity(hc.result.cluster);
println(sprintf("k-means: sizes %s, total within-SS %.2f (per point %.3f, expected about 2 sd^2 = %.2f), purity %.3f", json_stringify(km.result.size), km.result.tot_withinss, km.result.tot_withinss / n, 2 * sd * sd, pk));
println("k-means centre        nearest true centre   distance");
worst_centre = 0;
for (c = 0; c < k; c = c + 1) {
  best = 1000000; best_g = 0;
  for (g = 0; g < k; g = g + 1) {
    d = sqrt(pow(km.result.centers[c][0] - centres[g][0], 2) + pow(km.result.centers[c][1] - centres[g][1], 2));
    if (d < best) { best = d; best_g = g; }
  }
  if (best > worst_centre) { worst_centre = best; }
  println(sprintf("(%6.3f, %6.3f)      (%d, %d)                %.3f", km.result.centers[c][0], km.result.centers[c][1], centres[best_g][0], centres[best_g][1], best));
}
heights = hc.result.height; nh = len(heights);
println(sprintf("hierarchical (complete): %d merges, last three heights %.3f, %.3f, %.3f; purity of the 3-cut %.3f", nh, heights[nh - 3], heights[nh - 2], heights[nh - 1], ph));

// Self-checks. Centres 5-6 apart with sd 0.8 give essentially perfect recovery; allow one misassigned point per method.
if (pk < 1 - 1 / n || ph < 1 - 1 / n) { println("cluster recovery below expectation:", pk, ph); exit(1); }
if (worst_centre > 3 * sd / sqrt(m)) { println("a k-means centre is more than 3 SE from its true centre:", worst_centre); exit(1); }
// Within-SS per point estimates 2 sd^2 (two coordinates): accept 30% around 1.28.
if (abs(km.result.tot_withinss / n - 2 * sd * sd) > 0.3 * 2 * sd * sd) { println("within-SS per point far from 2 sd^2"); exit(1); }
if (len(km.result.cluster) != n || len(hc.result.cluster) != n || len(unique(km.result.cluster)) != k || len(unique(hc.result.cluster)) != k) { println("label vectors malformed"); exit(1); }
if (sum(km.result.size) != n) { println("sizes do not add up"); exit(1); }
// The two inter-cluster merges (the last two heights) sit far above the last within-cluster merge: a clear 3-cluster gap.
if (heights[nh - 2] < 1.5 * heights[nh - 3]) { println("no dendrogram gap at three clusters"); exit(1); }
// Determinism: the same seed and nstart reproduce the partition.
again = rcli.cluster_kmeans({data: {a: a, b: b}, k: k, seed: 7, nstart: 10});
if (again.status != "ok" || json_stringify(again.result.cluster) != json_stringify(km.result.cluster)) { println("k-means not reproducible with the same seed"); exit(1); }
println(sprintf("Checks passed: purity %.3f / %.3f; worst centre error %.3f; within-SS per point %.3f; dendrogram gap %.2fx; seeded rerun identical.", pk, ph, worst_centre, km.result.tot_withinss / n, heights[nh - 2] / heights[nh - 3]));
