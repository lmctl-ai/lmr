// One concept: fit a straight line to six exact points.
p = _lmcode_ cli="lmr" install="github:lmctl-ai/lmr@latest";
let x = seq(0.0, 5.0, 1.0);
let fit = lm(frame().set("x", x).set("y", 2.0 * x + 1.0), "y ~ x");
out.check_close(fit.estimates().at(0), 1.0, 0.000000000001, "intercept is 1");
out.check_close(fit.estimates().at(1), 2.0, 0.000000000001, "slope is 2");
out.set("intercept", fit.estimates().at(0));
out.set("slope", fit.estimates().at(1));
end _lmcode_
r = run_lmcode(p);
require(r.ok, "run failed: " + r.get("message", "unknown"));
result = r.result;
println(sprintf("Line fit: intercept %.1f, slope %.1f", result.values.intercept, result.values.slope));
write_file("build/rendered/linear-fit.txt", sprintf("Line fit: intercept %.1f, slope %.1f\n", result.values.intercept, result.values.slope));
