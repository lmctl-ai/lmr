// access: read
// Topic: nonlinear least squares with confidence intervals (after: R ?nls, ?confint.nls, the Michaelis-Menten example)
// What it does: simulates enzyme-kinetics data y = Vmax x / (Km + x) + noise, fits the curve with fit_nls (default
//   Gauss-Newton and the bounded port algorithm), prints the parameter table with t-based 95% intervals (dist_quantile),
//   checks that Vmax and Km are recovered inside the intervals, that the residual sigma matches the noise level, that the
//   fitted curve tracks the true curve, and that both algorithms agree.
// Data: 30 substrate levels x = 0, 0.25, ..., 7.25; y = 5 x / (1.5 + x) + N(0, 0.05^2) (rng_draw seed 42); truth Vmax 5, Km 1.5.
// Usage: export PATH="$PWD/bin:$PATH"; lmscript examples/tut-nls.lms
import "../cli.schema.dev.json" as rcli;

vmax = 5; km = 1.5; noise = 0.05; n = 30;
e = rcli.rng_draw({dist: "norm", n: n, mean: 0, sd: noise, seed: 42});
if (e.status == "simulated") { println("nls simulated."); exit(0); }
if (e.status != "ok") { println("rng_draw failed:", json_stringify(e)); exit(1); }
x = []; y = []; truth_y = [];
for (i = 0; i < n; i = i + 1) {
  xi = i / 4; fy = vmax * xi / (km + xi);
  x = concat(x, [xi]); truth_y = concat(truth_y, [fy]); y = concat(y, [fy + e.result.value[i]]);
}
fit = rcli.fit_nls({response: "y", rhs: "v*x/(k+x)", data: {x: x, y: y}, start: {v: 3, k: 3}, fitted: true, residuals: true});
if (fit.status != "ok") { println("fit_nls failed:", json_stringify(fit)); exit(1); }
r = fit.result;
q = rcli.dist_quantile({dist: "t", p: [0.975], df: r.df});
if (q.status != "ok") { println(json_stringify(q)); exit(1); }
tq = q.result.value[0];
println(sprintf("n=%d  converged=%s (%s) in %d iterations, achieved tolerance %s  sigma=%.4f (noise %.2f)  df=%d", n, r.converged, r.domain_status, r.iterations, str(r.achieved_tol), r.sigma, noise, r.df));
println("parameter   estimate   std_err    t        95% CI               truth");
truth = {v: vmax, k: km};
for (i = 0; i < len(r.coefficients); i = i + 1) {
  lo = r.estimate[i] - tq * r.std_error[i]; hi = r.estimate[i] + tq * r.std_error[i];
  println(sprintf("%-10s %9.4f %9.4f %8.2f  [%.4f, %.4f]   %.2f", r.coefficients[i], r.estimate[i], r.std_error[i], r.statistic[i], lo, hi, truth[r.coefficients[i]]));
  // Self-check 1: both generating parameters lie inside their 95% intervals.
  if (truth[r.coefficients[i]] < lo || truth[r.coefficients[i]] > hi) { println("true", r.coefficients[i], "outside its 95% interval"); exit(1); }
}
if (!r.converged) { println("nls did not converge"); exit(1); }
// Self-check 2: sigma is within 30% of the noise sd (chi-square(28) spread is about 13%).
if (abs(r.sigma - noise) > 0.3 * noise) { println("sigma far from the noise level:", r.sigma); exit(1); }
// Self-check 3: residuals = y - fitted, and the fitted curve is within 2 noise sd of the true curve everywhere.
worst = 0;
for (i = 0; i < n; i = i + 1) {
  if (abs(y[i] - r.fitted[i] - r.residuals[i]) > 0.000000001) { println("residuals do not match y - fitted"); exit(1); }
  if (abs(r.fitted[i] - truth_y[i]) > worst) { worst = abs(r.fitted[i] - truth_y[i]); }
}
println(sprintf("largest |fitted - true curve| over the grid: %.4f (2 sd = %.2f)", worst, 2 * noise));
if (worst > 2 * noise) { println("fitted curve strays from the truth"); exit(1); }
// Self-check 4: the port algorithm with box bounds that contain the truth reaches the same solution (within 1e-6).
port = rcli.fit_nls({response: "y", rhs: "v*x/(k+x)", data: {x: x, y: y}, start: {v: 3, k: 3}, algorithm: "port", lower: {v: 0, k: 0}, upper: {v: 20, k: 20}});
if (port.status != "ok") { println(json_stringify(port)); exit(1); }
for (i = 0; i < 2; i = i + 1) { if (abs(port.result.estimate[i] - r.estimate[i]) > 0.000001) { println("port and default solutions differ"); exit(1); } }
println(sprintf("Checks passed: Vmax=%.4f, Km=%.4f inside their intervals; sigma=%.4f; max curve error %.4f; port agrees to 1e-6 (%d iterations).", r.estimate[0], r.estimate[1], r.sigma, worst, port.result.iterations));
