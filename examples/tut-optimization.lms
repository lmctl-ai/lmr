// access: read
// Topic: optimisation, root finding and quadrature with analytic cross-checks (after: R ?optim, ?optimize, ?uniroot,
//   ?integrate; scipy-lectures optimisation chapter)
// What it does: minimises Rosenbrock's function with four optim methods (opt_minimize) and a bounded L-BFGS-B run whose
//   bound is active, checks the Hessian of a quadratic, minimises a scalar function with opt_optimize, brackets sqrt(2)
//   with num_root and integrates three functions with known closed forms (num_integrate), printing every result next to
//   its exact value.
// Data: deterministic analytic functions; no random input.
// Usage: export PATH="$PWD/bin:$PATH"; lmscript examples/tut-optimization.lms
import "../cli.schema.dev.json" as rcli;

rosen = "(1-a)^2+100*(b-a^2)^2";
println("method        a          b          f(a,b)       evals  status");
first = null;
for (method in ["Nelder-Mead", "BFGS", "CG", "L-BFGS-B"]) {
  m = rcli.opt_minimize({objective: rosen, start: {a: -1.2, b: 1}, method: method, maxit: 5000});
  if (m.status == "simulated") { println("optimisation simulated."); exit(0); }
  if (m.status != "ok") { println(method, "failed:", json_stringify(m)); exit(1); }
  r = m.result;
  println(sprintf("%-12s %9.6f %9.6f  %-24s %5d  %s", method, r.par.a, r.par.b, str(r.value), r.evals, r.domain_status));
  // Self-check 1: every method ends within 0.01 of (1, 1) (CG is the slowest; it is allowed to stop on maxit).
  if (abs(r.par.a - 1) > 0.01 || abs(r.par.b - 1) > 0.01) { println(method, "did not reach (1, 1)"); exit(1); }
  if (first == null) { first = r; }
}
// Self-check 2: a box bound that excludes the minimum becomes active: with a <= 0.5 the solution is a = 0.5, b = 0.25.
bounded = rcli.opt_minimize({objective: rosen, start: {a: -1.2, b: 1}, method: "L-BFGS-B", lower: {a: -2, b: -2}, upper: {a: 0.5, b: 2}});
if (bounded.status != "ok") { println(json_stringify(bounded)); exit(1); }
println(sprintf("L-BFGS-B with a <= 0.5: a=%.6f b=%.6f f=%.6f (%s)", bounded.result.par.a, bounded.result.par.b, bounded.result.value, bounded.result.message));
if (abs(bounded.result.par.a - 0.5) > 0.000001 || abs(bounded.result.par.b - 0.25) > 0.0001 || abs(bounded.result.value - 0.25) > 0.0001) { println("active bound solution wrong"); exit(1); }
// Self-check 3: the numerical Hessian of 2(a-1)^2 + 3(b+2)^2 + ab at the optimum is [[4,1],[1,6]].
quad = rcli.opt_minimize({objective: "2*(a-1)^2+3*(b+2)^2+a*b", start: {a: 0, b: 0}, method: "BFGS", hessian: true});
if (quad.status != "ok") { println(json_stringify(quad)); exit(1); }
h = quad.result.hessian;
println(sprintf("quadratic: minimum at (%.6f, %.6f), Hessian [[%.4f, %.4f], [%.4f, %.4f]] (exact [[4,1],[1,6]])", quad.result.par.a, quad.result.par.b, h[0][0], h[0][1], h[1][0], h[1][1]));
if (abs(h[0][0] - 4) > 0.001 || abs(h[0][1] - 1) > 0.001 || abs(h[1][0] - 1) > 0.001 || abs(h[1][1] - 6) > 0.001) { println("Hessian differs from the exact matrix"); exit(1); }
// Exact minimiser: gradient 4(a-1)+b = 0, 6(b+2)+a = 0 -> a = 36/23, b = -52/23.
if (abs(quad.result.par.a - 36 / 23) > 0.0001 || abs(quad.result.par.b + 52 / 23) > 0.0001) { println("quadratic minimiser wrong"); exit(1); }
// Self-check 4: one-dimensional problems against closed forms.
o = rcli.opt_optimize({objective: "x*exp(-x)", lower: 0, upper: 5, maximum: true, tol: 0.000000001});
rt = rcli.num_root({f: "x^2-2", lower: 1, upper: 2, tol: 0.000000000001});
if (o.status != "ok" || rt.status != "ok") { println(json_stringify(o), json_stringify(rt)); exit(1); }
println(sprintf("max of x exp(-x) on [0,5]: x=%.8f (exact 1), value %.8f (exact 1/e=%.8f); root of x^2-2 in [1,2]: %.12f (sqrt 2 = %.12f) after %d iterations", o.result.x, o.result.value, 1 / 2.718281828459045, rt.result.root, sqrt(2), rt.result.iter));
if (abs(o.result.x - 1) > 0.00001 || abs(o.result.value - 1 / 2.718281828459045) > 0.000000001) { println("optimize result wrong"); exit(1); }
if (abs(rt.result.root - sqrt(2)) > 0.000000001) { println("root wrong"); exit(1); }
// Self-check 5: quadrature against closed forms, within the reported absolute error plus 1e-10. (The lmscript client types
// the bounds as numbers, so the Gaussian tail is cut at 40 where it is below 1e-600 instead of using the "Inf" string.)
cases = [["x^2", 0, 1, 1 / 3, "1/3"], ["1/(1+x^2)", 0, 1, 3.141592653589793 / 4, "pi/4"], ["exp(-x^2)", 0, 40, sqrt(3.141592653589793) / 2, "sqrt(pi)/2 (tail beyond 40 < 1e-600)"]];
for (c in cases) {
  g = rcli.num_integrate({f: c[0], lower: c[1], upper: c[2], rel_tol: 0.000000000001});
  if (g.status != "ok") { println(json_stringify(g)); exit(1); }
  println(sprintf("integral of %-10s over [%s, %s] = %.12f  exact %s = %.12f  (abs error estimate %s, %d subdivisions)", c[0], str(c[1]), str(c[2]), g.result.value, c[4], c[3], str(g.result.abs_error), g.result.subdivisions));
  if (abs(g.result.value - c[3]) > g.result.abs_error + 0.0000000001) { println("integral outside its error bound"); exit(1); }
}
println("Checks passed: four optim methods reach (1,1); active bound gives a=0.5; Hessian [[4,1],[1,6]]; optimize, uniroot and three integrals match closed forms.");
