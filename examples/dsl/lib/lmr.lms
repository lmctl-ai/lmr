// lmr: run-and-check helpers shared by the _lmcode_ examples.
//   lmr.run(dsl, name)      -> runs one _lmcode_ block through lmr (run_lmcode) and returns the
//                              result as a map {ok, code, values, checks, message}
//                              (name is kept for source compatibility; it no longer names a file)
//   lmr.run_many(dsls)      -> runs several blocks in ONE lmr process via lmcode_build
//                              (keep()/kept_*() state carries across them); returns the aggregate
//                              (the last slot's values/checks) with the same map shape
//   lmr.check(res)          -> exits with the host-side code class when the run failed, else returns res.values
// Effects: lmscript hands the block(s) to lmr itself; nothing is written by this library.
// Under --dry-run the block is checked and planned but nothing runs; the dry envelope returns empty values.
package lmr;

function _argv0() {
  b = env("LMR_BIN", "");
  if (b != "") { return b; }
  w = which("lmr");
  if (w != null) { return w; }
  return abs_path("build-native/bin/lmr");
}

function _map_result(r) {
  if (r.ok) {
    if (is_array(r.result)) {
      last = r.result[r.result.len() - 1];
      return {ok: true, code: 0, values: last.values, checks: last.checks, message: null, parts: r.result.len()};
    }
    return {ok: true, code: 0, values: r.result.values, checks: r.result.checks, message: null};
  }
  where = r.has("line") ? " (dsl line " + str(r.line) + ")" : "";
  part = r.has("part") ? " (slot " + str(r.part) + ")" : "";
  code = r.code == "APP_FAIL" ? 4 : (r.phase == "cli" ? 2 : 3);
  return {ok: false, code: code, values: {}, message: r.phase + " " + r.code + ": " + r.message + where + part};
}

function run(dsl, name) {
  b = lmcode_build([_argv0()]);
  b.add(dsl);
  return _map_result(run_lmcode(b));
}

function run_many(dsls) {
  b = lmcode_build([_argv0()]);
  for (p in dsls) {
    b.add(p);
  }
  return _map_result(run_lmcode(b));
}

function check(res) {
  if (!res.ok) {
    println("lmr failed:", res.message);
    exit(res.code == 0 ? 1 : res.code);
  }
  return res.values;
}

