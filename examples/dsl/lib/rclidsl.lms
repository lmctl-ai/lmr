// rclidsl: compile-and-run helpers shared by the _dsl_ examples.
//   rclidsl.binary()            -> path of rcli-dsl ($RCLI_DSL, then PATH, then build-native/bin/rcli-dsl)
//   rclidsl.save(dsl, name)     -> writes build/dsl/NAME.dslb and returns the path
//   rclidsl.exec(paths)         -> runs the bytecode files in ONE rcli-dsl process (shared host state);
//                                  echoes the chunks' report text and returns {code, ok, values, message}
//   rclidsl.run(dsl, name)      -> save + exec of one chunk
//   rclidsl.check(res)          -> exits with the host's code when the run failed, else returns res.values
// Effects: creates build/dsl/ below the working directory; spawns rcli-dsl with argv (no shell).
// Under --dry-run nothing is written or spawned and exec returns {code: 0, ok: true, values: {}, simulated: true}.
package rclidsl;

function binary() {
  b = env("RCLI_DSL", "");
  if (b != "") { return b; }
  w = which("rcli-dsl");
  if (w != null) { return w; }
  return abs_path("build-native/bin/rcli-dsl");
}

function save(dsl, name) {
  mkdir("build/dsl");
  path = "build/dsl/" + name + ".dslb";
  savedsl(dsl, path);
  return path;
}

function exec(paths) {
  argv = concat([binary(), "--dsl"], paths);
  r = system(argv, {timeoutMs: 600000});
  if (r.code == null) { return {code: 0, ok: true, values: {}, simulated: true}; }
  if (r.stderr != "") { printf("%s", r.stderr); }
  last = "";
  for (line in lines(r.stdout)) { if (trim(line) != "") { last = line; } }
  if (last == "") { return {code: r.code, ok: false, values: {}, message: "rcli-dsl printed no result line (exit " + str(r.code) + ")"}; }
  res = json_parse(last);
  if (res.ok) { return {code: r.code, ok: true, values: res.result.values, checks: res.result.checks}; }
  where = has_key(res, "line") ? " (dsl line " + str(res.line) + ")" : "";
  return {code: r.code, ok: false, values: {}, message: res.phase + " " + res.code + ": " + res.message + where};
}

function run(dsl, name) {
  return exec([save(dsl, name)]);
}

function check(res) {
  if (!res.ok) {
    println("rcli-dsl failed:", res.message);
    exit(res.code == 0 ? 1 : res.code);
  }
  return res.values;
}
