// access: write (build/dsl/fit-and-forecast.dslb)
// Topic: R parity of the native ARIMA fit and forecast (after: R ?arima, ?predict.Arima)
// What it does: one _lmcode_ chunk fits ARIMA(1,0,0) by CSS-ML to a fixed 80-value series and checks the five forecasts
//   against the R 4.3.3 fixture of examples/fit-and-forecast.lms (want, the forecasts of predict(n.ahead = 5)). It also
//   checks the AR coefficient against R's coef(fit)["ar1"] = 0.63660174102528411 and the forecast SEs against the AR(1)
//   formula.
// Data: the series is R's own: set.seed(42); x <- arima.sim(n = 80, list(ar = 0.65)), printed with %.17g by Rscript (used
//   as a black-box oracle) and embedded with parse_vec, so the check does not depend on the native random generator.
//   R then ran arima(x, c(1, 0, 0), method = "CSS-ML") and predict(fit, n.ahead = 5) to produce want.
// Tolerance: 1e-8 absolute for the coefficient and each forecast, the same as the original R-backed fixture. The native
//   optimiser path differs from R's, and docs/dsl-api.md quotes ARIMA agreement to about 1e-4 in general, but on this
//   well-conditioned AR(1) the measured differences are 2.2e-10 (ar1) and at most 4.8e-10 (forecasts), so the original
//   1e-8 holds with a 20x margin.
// Usage: lmscript examples/dsl/fit-and-forecast.lms   (cwd = repository root; lmr on PATH or in build-native/bin)
import "lib/lmr.lms";

p = _lmcode_ schema="../../native/schema/lmr.dsl.json";
let x = parse_vec("0.74001454026531066 0.19675652975637956 -2.5285636765631296 -4.0840333183415529 -1.3345083111918177 -1.1740689963531561 -2.544453281609552 -1.8258119888058302 0.027896906448809305 1.9133264504566914 0.81319306119064982 0.27130610700499275 -1.586814115641535 -0.57133182033572638 -1.0113605591783414 -0.2019342402247026 0.57358008108276248 1.4079305746737178 0.30622849813070524 0.70400364708292862 -1.2594063084694394 -1.6030731088846319 -1.8929051149515292 -3.6445959746651262 -2.3328647766400765 -1.310363504615796 -1.2127935765489337 -0.030152589057289896 -0.74630400996381352 -1.8533786508957732 -0.77187809719353562 -1.3131139393624698 0.59057720113564738 -0.047571021875174625 0.6247267191833431 0.72799763267311957 -0.31064047964284769 1.3738112080241263 1.5358765909329986 1.0880804307060548 0.98380302725039859 1.31876078376803 0.94702739602830122 -2.3775222757345391 -1.2605065256967911 -1.1865638844438895 -0.5860359600229188 0.20090035335060968 1.5303220569705742 0.26741727755640832 1.4763638624558089 1.2954846303483503 1.8805711084240488 2.1430997887662779 2.1138930255649431 0.33091152804935808 0.12490610662137608 0.70470713130343798 -0.49546372242510928 -0.86488023415017778 0.0188243454840668 0.78041456239923446 0.97103705409966956 -0.25460221224489421 -1.2652723366070366 0.6902799910103542 0.70660343168876105 0.54773245975728102 0.23512956130314325 -1.041494680313485 -0.064974644163378364 -0.2593733644527168 -0.35134939322618763 0.70496922297413811 1.2800031054414387 2.2241183944712062 0.9695030333516097 1.2805255324048512 2.2234520524531542 0.33445495464665148");
let want = parse_vec("0.203613879492466 0.12032022325169149 0.0672953366724529 0.03353960155844138 0.012050641815273329");
let r_ar1 = 0.63660174102528411;
let fit = arima(1, 0, 0).method("CSS-ML").fit(x);
let fc = fit.forecast(5);
out.print(fmt("AR(1) coefficient: %.8f", fit.estimate("ar1")) + fmt(" (R %.8f,", r_ar1) + fmt(" difference %.2e)", abs(fit.estimate("ar1") - r_ar1)) + fmt("; intercept %.8f", fit.estimate("intercept")));
out.print("  h   native forecast        R forecast            |difference|");
let worst = 0.0;
for (h in range(0, 5)) {
  let d = abs(fc.mean_at(h) - want.at(h));
  worst = max(worst, d);
  out.print(fmt("%3d", h + 1) + fmt("   %.15f", fc.mean_at(h)) + fmt("   %.15f", want.at(h)) + fmt("   %.2e", d));
}
out.print(fmt("max forecast difference from R: %.3e", worst));
out.check(x.len() == 80, "the embedded R series has 80 values");
out.check(fit.convergence() == 0, "CSS-ML fit converged");
for (h in range(0, 5)) {
  out.check(abs(fc.mean_at(h) - want.at(h)) <= 0.00000001, fmt("forecast %d matches the R 4.3.3 fixture within 1e-8", h + 1));
}
out.check(abs(fit.estimate("ar1") - r_ar1) <= 0.00000001, "ar1 matches R within 1e-8");
let phi = fit.estimate("ar1");
for (h in range(1, 6)) {
  let se = sqrt(fit.sigma2() * (1.0 - pow(phi, 2.0 * float(h))) / (1.0 - phi * phi));
  out.check(abs(fc.se_at(h - 1) - se) <= 0.000001, fmt("forecast SE follows the AR(1) formula at h = %d", h));
}
out.set("ar1", phi);
out.set("forecast", fc.mean());
out.set("max_diff", worst);
end _lmcode_

v = lmr.check(lmr.run(p, "fit-and-forecast"));
println("AR(1) coefficient:", sprintf("%.6f", v.ar1));
println("Five forecasts:", json_stringify(v.forecast));
println(sprintf("R forecast fixture passed (absolute tolerance 1e-8; max difference %s).", str(v.max_diff)));
