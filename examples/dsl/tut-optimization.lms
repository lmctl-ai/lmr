// access: write (build/dsl/tut-optimization.dslb)
// Topic: optimisation, root finding and quadrature with analytic cross-checks (after: R ?optim, ?optimize, ?uniroot,
//   ?integrate; scipy-lectures optimisation chapter)
// What it does: one _dsl_ chunk minimises Rosenbrock's function with four methods (minimize: Nelder-Mead, BFGS, CG,
//   L-BFGS-B) and a bounded L-BFGS-B run whose bound is active, checks the numerical Hessian of a quadratic, maximises a
//   scalar function with optimize, brackets sqrt(2) with uniroot and integrates three functions with known closed forms
//   (integrate), printing every result next to its exact value. Every objective and integrand is DSL code driven by
//   reverse communication. Same checks and tolerances as examples/tut-optimization.lms; one difference: the Gaussian
//   integral now runs over [0, Inf) (the native integrate accepts inf() bounds), where the original cut it at 40.
// Data: deterministic analytic functions; no random input.
// Usage: lmscript examples/dsl/tut-optimization.lms   (cwd = repository root; rcli-dsl on PATH or in build-native/bin)
import "lib/rclidsl.lms";

p = _dsl_ schema="../../native/schema/rcli.dsl.json";
fn rosen(a: float, b: float) -> float {
  return pow(1.0 - a, 2.0) + 100.0 * pow(b - a * a, 2.0);
}
fn quad(a: float, b: float) -> float {
  return 2.0 * pow(a - 1.0, 2.0) + 3.0 * pow(b + 2.0, 2.0) + a * b;
}
out.print("method        a          b          f(a,b)        fn   conv");
let methods = split("Nelder-Mead,BFGS,CG,L-BFGS-B", ",");
for (i in range(0, methods.len())) {
  let o = minimize(parse_vec("-1.2 1"), methods.at(i)).maxit(5000);
  while (o.next()) {
    o.tell(rosen(o.x(0), o.x(1)));
  }
  out.print(fmt("%-12s", methods.at(i)) + fmt(" %9.6f", o.par(0)) + fmt(" %9.6f", o.par(1)) + fmt("  %-12.6e", o.value()) + fmt(" %5d", o.fn_count()) + fmt("  %d", o.convergence()));
  # Self-check 1: every method ends within 0.01 of (1, 1) (CG is the slowest; it is allowed to stop on maxit).
  out.check(abs(o.par(0) - 1.0) <= 0.01 && abs(o.par(1) - 1.0) <= 0.01, methods.at(i) + " reaches (1, 1) within 0.01");
}
# Self-check 2: a box bound that excludes the minimum becomes active: with a <= 0.5 the solution is a = 0.5, b = 0.25.
let bd = minimize(parse_vec("-1.2 1"), "L-BFGS-B").lower(parse_vec("-2 -2")).upper(parse_vec("0.5 2"));
while (bd.next()) {
  bd.tell(rosen(bd.x(0), bd.x(1)));
}
out.print(fmt("L-BFGS-B with a <= 0.5: a=%.6f", bd.par(0)) + fmt(" b=%.6f", bd.par(1)) + fmt(" f=%.6f", bd.value()) + " (" + bd.message() + ")");
out.check(abs(bd.par(0) - 0.5) <= 0.000001, "active bound: a = 0.5");
out.check(abs(bd.par(1) - 0.25) <= 0.0001, "active bound: b = 0.25");
out.check(abs(bd.value() - 0.25) <= 0.0001, "active bound: f = 0.25");
# Self-check 3: the numerical Hessian of 2(a-1)^2 + 3(b+2)^2 + ab at the optimum is [[4,1],[1,6]].
let q = minimize(parse_vec("0 0"), "BFGS").hessian(true);
while (q.next()) {
  q.tell(quad(q.x(0), q.x(1)));
}
out.print(fmt("quadratic: minimum at (%.6f, ", q.par(0)) + fmt("%.6f), Hessian ", q.par(1)) + fmt("[[%.4f, ", q.hessian(0, 0)) + fmt("%.4f], ", q.hessian(0, 1)) + fmt("[%.4f, ", q.hessian(1, 0)) + fmt("%.4f]] (exact [[4,1],[1,6]])", q.hessian(1, 1)));
out.check(abs(q.hessian(0, 0) - 4.0) <= 0.001 && abs(q.hessian(0, 1) - 1.0) <= 0.001 && abs(q.hessian(1, 0) - 1.0) <= 0.001 && abs(q.hessian(1, 1) - 6.0) <= 0.001, "Hessian equals [[4,1],[1,6]] within 0.001");
# Exact minimiser: gradient 4(a-1)+b = 0, 6(b+2)+a = 0 -> a = 36/23, b = -52/23.
out.check(abs(q.par(0) - 36.0 / 23.0) <= 0.0001 && abs(q.par(1) + 52.0 / 23.0) <= 0.0001, "quadratic minimiser (36/23, -52/23)");
# Self-check 4: one-dimensional problems against closed forms.
let om = optimize(0.0, 5.0, true).tol(0.000000001);
while (om.next()) {
  om.tell(om.x() * exp(-om.x()));
}
let rt = uniroot(1.0, 2.0).tol(0.000000000001);
while (rt.next()) {
  rt.tell(rt.x() * rt.x() - 2.0);
}
out.print(fmt("max of x exp(-x) on [0,5]: x=%.8f (exact 1), ", om.argmin()) + fmt("value %.8f ", om.objective()) + fmt("(exact 1/e=%.8f)", exp(-1.0)));
out.print(fmt("root of x^2-2 in [1,2]: %.12f ", rt.root()) + fmt("(sqrt 2 = %.12f)", sqrt(2.0)) + fmt(" after %d iterations", rt.iter()));
out.check(abs(om.argmin() - 1.0) <= 0.00001, "optimize: maximiser 1 within 1e-5");
out.check(abs(om.objective() - exp(-1.0)) <= 0.000000001, "optimize: maximum 1/e within 1e-9");
out.check(abs(rt.root() - sqrt(2.0)) <= 0.000000001, "uniroot: sqrt(2) within 1e-9");
# Self-check 5: quadrature against closed forms, within a fixed 1e-10 (relative to max(1, |exact|)) and within the
# reported absolute error plus 1e-10; the fixed bound matters because the error estimate can be loose.
let names = split("x^2,1/(1+x^2),exp(-x^2)", ",");
let exacts = parse_vec("0 0 0").set(0, 1.0 / 3.0).set(1, pi() / 4.0).set(2, sqrt(pi()) / 2.0);
let labels = split("1/3,pi/4,sqrt(pi)/2", ",");
let uppers = parse_vec("1 1 0").set(2, inf());
for (c in range(0, 3)) {
  let g = integrate(0.0, uppers.at(c)).rel_tol(0.000000000001);
  while (g.next()) {
    let x = g.x();
    let v = x * x;
    if (c == 1) {
      v = 1.0 / (1.0 + x * x);
    }
    if (c == 2) {
      v = exp(-x * x);
    }
    g.tell(v);
  }
  let err = abs(g.value() - exacts.at(c));
  out.print("integral of " + fmt("%-12s", names.at(c)) + fmt(" over [0, %g]", uppers.at(c)) + fmt(" = %.12f", g.value()) + "  exact " + labels.at(c) + fmt(" = %.12f", exacts.at(c)) + fmt("  (abs error estimate %.2e", g.abs_error()) + fmt(", %d subdivisions)", g.subdivisions_used()));
  out.check(g.ok() && err <= 0.0000000001 * max(1.0, abs(exacts.at(c))) && err <= g.abs_error() + 0.0000000001, "integral of " + names.at(c) + " within 1e-10 of " + labels.at(c) + " and within its error bound");
}
out.set("bounded_a", bd.par(0));
out.set("root", rt.root());
out.set("hessian_11", q.hessian(1, 1));
end _dsl_

values = rclidsl.check(rclidsl.run(p, "tut-optimization"));
println(sprintf("Checks passed: four optim methods reach (1,1); active bound gives a=%.6f; Hessian [[4,1],[1,%.4f]]; optimize, uniroot (root %.12f) and three integrals match closed forms.", values.bounded_a, values.hessian_11, values.root));
