// access: write (build/dsl/tut-integrate.dslb)
// Topic: numerical integration against closed forms, including singular, infinite and divergent cases (after: R ?integrate,
//   ?uniroot, ?optimize; numerical-analysis quadrature exercises)
// What it does: one _lmcode_ chunk integrates seven functions with the native integrate (QUADPACK; the integrands are written
//   in the chunk and evaluated by reverse communication) and prints each value next to its closed form, verifying the
//   error estimate brackets the truth. The Gamma integral runs over [0, inf()) and the Gaussian over (-inf(), inf()):
//   the original used [0, 200] and [-40, 40] only because its client could not pass infinite bounds. It then shows the
//   three outcomes R distinguishes (OK; the subdivision limit, ier 1; a non-finite integrand, ier 6 with ok() false
//   rather than an error), cross-checks the Gamma integral with gamma(), locates pi/2 as the root of cos (uniroot) and
//   the maximum of sin (optimize). Same checks as examples/tut-integrate.lms; the original's domain statuses
//   (OK / NON_CONVERGED / NON_FINITE) are checked through Integral.ier() and ok().
// Data: analytic functions only.
// Usage: lmscript examples/dsl/tut-integrate.lms   (cwd = repository root; lmr on PATH or in build-native/bin)
import "lib/lmr.lms";

p = _lmcode_ schema="../../native/schema/lmr.dsl.json";
# The seven integrands, selected by case number (the DSL has no function values).
fn f(c: int, x: float) -> float {
  let v = x * x * x - 3.0 * x;
  if (c == 0) {
    v = sin(x);
  } else if (c == 1) {
    v = 4.0 / (1.0 + x * x);
  } else if (c == 2) {
    v = x * x * exp(-x);
  } else if (c == 3) {
    v = 1.0 / sqrt(x);
  } else if (c == 4) {
    v = exp(-x * x / 2.0);
  } else if (c == 5) {
    v = log(x);
  }
  return v;
}
let names = str_split("sin(x)|4/(1+x^2)|x^2*exp(-x)|1/sqrt(x)|exp(-x^2/2)|log(x)|x^3-3*x", "|");
let notes = str_split("2|pi|Gamma(3) = 2|2 (integrable singularity)|sqrt(2 pi)|-1 (log singularity)|0 (odd function)", "|");
let lower = vec().push(0.0).push(0.0).push(0.0).push(0.0).push(-inf()).push(0.0).push(-2.0);
let upper = vec().push(pi()).push(1.0).push(inf()).push(1.0).push(inf()).push(1.0).push(2.0);
let exact = vec().push(2.0).push(pi()).push(2.0).push(2.0).push(sqrt(2.0 * pi())).push(-1.0).push(0.0);
out.print("integrand        bounds             value              exact                 |error|      est. bound   subdivisions");
# abs_tol defaults to rel_tol (as in R); it is set explicitly here only to make the tolerance visible.
for (c in range(0, 7)) {
  let g = integrate(lower.at(c), upper.at(c)).rel_tol(0.000000000001).abs_tol(0.000000000001).subdivisions(200);
  while (g.next()) {
    g.tell(f(c, g.x()));
  }
  let err = abs(g.value() - exact.at(c));
  out.print(fmt("%-16s", names.at(c)) + fmt(" [%6g, ", lower.at(c)) + fmt("%6g]", upper.at(c)) + fmt("  %18.12f", g.value()) + fmt("  %-20s", notes.at(c)) + fmt("  %-11.3e", err) + fmt("  %-11.3e", g.abs_error()) + fmt("  %3d  ", g.subdivisions_used()) + g.message());
  # Self-check 1: every value is within 1e-10 (relative to max(1, |exact|)) of the closed form, a fixed bound that does
  # not depend on the integrator's own (loose) error estimate, and also inside that estimate plus 1e-9; the status is OK.
  out.check(err <= 0.0000000001 * max(1.0, abs(exact.at(c))), "integral of " + names.at(c) + " within 1e-10 of the closed form");
  out.check(err <= g.abs_error() + 0.000000001, "integral of " + names.at(c) + " inside its error bound");
  out.check(g.ok() && g.ier() == 0, "integral of " + names.at(c) + " reports OK");
}
# Self-check 2: a divergent integral is reported, not silently returned: 1/x on (0, 1] exhausts the subdivisions.
let dv = integrate(0.0, 1.0).subdivisions(50);
while (dv.next()) {
  dv.tell(1.0 / dv.x());
}
out.print(fmt("1/x on (0,1]: value %.3f", dv.value()) + ", message '" + dv.message() + "'" + fmt(", ier %d", dv.ier()) + fmt(", subdivisions %d", dv.subdivisions_used()));
out.check(!dv.ok() && dv.ier() == 1 && dv.subdivisions_used() == 50, "divergent integral flagged at the subdivision limit");
# A non-finite integrand (sqrt of a negative argument) is a domain outcome too: ier 6, not a run error.
let bad = integrate(-1.0, 1.0);
while (bad.next()) {
  bad.tell(sqrt(bad.x()));
}
out.print("sqrt(x) on [-1,1]: " + fmt("ier %d", bad.ier()) + ", ok " + str(bad.ok()) + ", message '" + bad.message() + "'");
out.check(!bad.ok() && bad.ier() == 6, "non-finite integrand flagged");
# Self-check 3: Gamma(3) equals 2, the closed form of the x^2 exp(-x) integral above, and Gamma(0.5)^2 = pi.
out.print(fmt("Gamma(3) = %.12f", gamma(3.0)) + fmt(", Gamma(1/2)^2 = %.12f", gamma(0.5) * gamma(0.5)) + fmt(" (pi = %.12f)", pi()));
out.check_close(gamma(3.0), 2.0, 0.000000000001, "Gamma(3) = 2");
out.check_close(gamma(0.5) * gamma(0.5), pi(), 0.000000000001, "Gamma(1/2)^2 = pi");
# Self-check 4: pi/2 as the root of cos on [1, 2] and the maximiser of sin on [0, 3].
let rt = uniroot(1.0, 2.0).tol(0.000000000001);
while (rt.next()) {
  rt.tell(cos(rt.x()));
}
let mx = optimize(0.0, 3.0, true).tol(0.000000001);
while (mx.next()) {
  mx.tell(sin(mx.x()));
}
out.print(fmt("root of cos in [1,2]: %.12f", rt.root()) + fmt("; argmax of sin on [0,3]: %.9f", mx.argmin()) + fmt(" (max %.12f)", mx.objective()) + fmt("; pi/2 = %.12f", pi() / 2.0));
out.check_close(rt.root(), pi() / 2.0, 0.000000001, "root of cos is pi/2");
out.check_close(mx.argmin(), pi() / 2.0, 0.00001, "argmax of sin is pi/2");
out.check_close(mx.objective(), 1.0, 0.000000001, "max of sin is 1");
out.set("root", rt.root());
out.set("argmax", mx.argmin());
out.set("div_message", dv.message());
end _lmcode_

values = lmr.check(lmr.run(p, "tut-integrate"));
println(sprintf("Checks passed: seven integrals (two over infinite ranges) within 1e-10 of their closed forms and inside their error bounds; divergence ('%s') and non-finite integrands flagged; Gamma(3) = 2, Gamma(1/2)^2 = pi; cos root %.12f and sin maximum %.9f at pi/2.", values.div_message, values.root, values.argmax));
