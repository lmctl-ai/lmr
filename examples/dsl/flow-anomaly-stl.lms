// access: write (build/dsl/: flow-anomaly-*.dslb, flow-anomaly.csv)
// Topic: anomaly detection on a seasonal series, with lmscript tuning the detector by re-running a native chunk.
// What it does:
//   A DSL chunk simulates 10 years of monthly data (trend + fixed seasonal cycle + AR(1) noise) with three injected
//   spikes at known months, decomposes it with robust STL, and flags months whose remainder exceeds THRESHOLD robust
//   standard deviations (MAD). It publishes the flagged months and writes the components to CSV.
//   lmscript runs the chunk with a strict threshold first and lowers it until every injected spike is found or the
//   threshold would drop below 3, printing precision and recall at each step. ${tenths} is substituted as an int
//   literal, so each round is a fresh compile of the same chunk.
// Usage: lmscript examples/dsl/flow-anomaly-stl.lms   (cwd = repository root)
import "lib/lmr.lms";

injected = [27, 64, 101];
tenths = 80;
found = [];
round = 0;
mkdir("build/dsl");
while (tenths >= 30) {
  round = round + 1;
  detect = _dsl_ schema="../../native/schema/lmr.dsl.json";
  let r = rng(1999);
  let n = 120;
  let noise = arima_sim(r, n, parse_vec("0.4"), vec(), 0.5);
  let season = parse_vec("-2 -1 1 3 4 2 -1 -3 -4 -2 1 2");
  let x = vec();
  for (t in range(0, n)) {
    let spike = 0.0;
    if (t == 27 || t == 64 || t == 101) {
      spike = 2.0;
    }
    x.push(10.0 + 0.05 * float(t) + season.at(t % 12) + noise.at(t) + spike);
  }
  let s = stl(x, 12, 13, true);
  let rem = s.remainder();
  let scale = rem.mad();
  let threshold = float(${tenths}) / 10.0;
  let flags = vec();
  for (t in range(0, n)) {
    if (abs(rem.at(t) - rem.median()) > threshold * scale) {
      flags.push(float(t));
    }
  }
  frame().set("x", x).set("trend", s.trend()).set("seasonal", s.seasonal()).set("remainder", rem).set("weight", s.weights()).write_csv("build/dsl/flow-anomaly.csv");
  out.print(fmt("threshold %.1f MAD", threshold) + fmt(" (MAD %.3f): ", scale) + fmt("%d months flagged", flags.len()));
  out.set("flags", flags);
end _dsl_
  v = lmr.check(lmr.run(detect, "flow-anomaly"));
  if (!has_key(v, "flags")) { println("dry run: nothing executed"); exit(0); }
  found = v.flags;
  hits = 0;
  for (t in injected) { if (index_of(found, t) >= 0) { hits = hits + 1; } }
  precision = len(found) == 0 ? 1 : hits / len(found);
  println(sprintf("round %d: threshold %.1f -> flagged %s; recall %d/3, precision %.2f", round, tenths / 10, json_stringify(found), hits, precision));
  if (hits == len(injected)) { break; }
  tenths = tenths - 10;
}
if (len(found) == 0 || tenths < 30) { println("the detector never found all injected spikes"); exit(1); }
for (t in injected) { if (index_of(found, t) < 0) { println("missed injected spike at month", t); exit(1); } }
if (len(found) > 6) { println("too many false alarms:", json_stringify(found)); exit(1); }
println(sprintf("Flow passed: all three injected spikes found at threshold %.1f MAD with %d flags in total (components in build/dsl/flow-anomaly.csv).", tenths / 10, len(found)));
