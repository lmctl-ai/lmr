// access: write (build/dsl/minimize-rosenbrock.dslb)
// Topic: unconstrained minimisation of Rosenbrock's banana function with BFGS (after: R ?optim)
// What it does: one _lmcode_ chunk minimises 100 (b - a^2)^2 + (1 - a)^2 from (-1.2, 1) with the native BFGS (maxit 1000,
//   reltol 1e-8); the objective is ordinary DSL code fed to the optimiser by reverse communication. It checks the known
//   minimum (1, 1): parameters within 0.005 and objective below 1e-6, the same tolerances as
//   examples/minimize-rosenbrock.lms (formerly an R-oracle fixture; the minimum is known analytically, so no R is needed).
// Data: deterministic analytic function; no random input.
// Usage: lmscript examples/dsl/minimize-rosenbrock.lms   (cwd = repository root; lmr on PATH or in build-native/bin)
import "lib/lmr.lms";

p = _lmcode_ schema="../../native/schema/lmr.dsl.json";
fn rosen(a: float, b: float) -> float {
  return 100.0 * pow(b - a * a, 2.0) + pow(1.0 - a, 2.0);
}
let o = minimize(parse_vec("-1.2 1"), "BFGS").maxit(1000).reltol(0.00000001);
while (o.next()) {
  o.tell(rosen(o.x(0), o.x(1)));
}
out.print(fmt("Rosenbrock minimum: a=%.6f", o.par(0)) + fmt(" b=%.6f", o.par(1)) + fmt(" value=%.8f", o.value()) + fmt("  (fn %d", o.fn_count()) + fmt(", gr %d", o.gr_count()) + fmt(", convergence %d)", o.convergence()));
out.check(o.convergence() == 0, "BFGS reports convergence");
out.check(abs(o.par(0) - 1.0) <= 0.005, "a within 0.005 of 1");
out.check(abs(o.par(1) - 1.0) <= 0.005, "b within 0.005 of 1");
out.check(o.value() <= 0.000001, "objective below 1e-6");
out.set("a", o.par(0));
out.set("b", o.par(1));
out.set("value", o.value());
end _lmcode_

values = lmr.check(lmr.run(p, "minimize-rosenbrock"));
println(sprintf("Checks passed: Rosenbrock minimum at a=%.6f b=%.6f (within 0.005 of (1, 1)), value %.8f below 1e-6.", values.a, values.b, values.value));
