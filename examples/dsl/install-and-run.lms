// access: write (a temporary install-and-run.dslb, removed)
// What it does: the zero-setup way to use lmr from lmscript. No schema file and no manual install:
//   - cli="lmr" makes lmscript ask the lmr binary for its schema (`lmr --dsl-schema --json`) and compile against exactly
//     those bytes, so the bytecode is bound to the binary that will run it;
//   - install="github:lmctl-ai/lmr@v0.4.0" says where lmr comes from when it is not on PATH: lmscript downloads the
//     release asset lmr-OS-ARCH[.exe] (linux/macos/windows, x64/arm64) once into its tool cache, verified against the
//     SHA-256 digest GitHub reports, and uses it from then on;
//   - dsl_cli(p) is the argv prefix of that exact binary, so `system ${dsl_cli(p)} --dsl FILE` runs it.
// The program itself: a normal quantile, a root found by reverse communication and a straight-line fit, each with a
//   known answer.
// How to run: lmscript examples/dsl/install-and-run.lms   (works on a machine with only Node.js and lmscript installed)
p = _dsl_ cli="lmr" install="github:lmctl-ai/lmr@v0.4.0";
out.check_close(norm().q_vec(parse_vec("0.975")).at(0), 1.959963984540054, 0.00000000000001, "normal 97.5% quantile");
let rt = uniroot(1.0, 2.0).tol(0.000000000001);
while (rt.next()) {
  rt.tell(rt.x() * rt.x() - 2.0);
}
out.check_close(rt.root(), sqrt(2.0), 0.000000001, "root of x^2 - 2 is sqrt(2)");
let x = seq(0.0, 9.0, 1.0);
let fit = lm(frame().set("x", x).set("y", x * 2.0 + 1.0), "y ~ x");
out.check_close(fit.estimates().at(0), 1.0, 0.000000000001, "intercept of y = 1 + 2x");
out.check_close(fit.estimates().at(1), 2.0, 0.000000000001, "slope of y = 1 + 2x");
out.set("root", rt.root());
end _dsl_

file = "install-and-run.dslb";
savedsl(p, file);
r = system ${dsl_cli(p)} --dsl ${file};
delete_file(file);
if (r.code != 0) { println(f"lmr exit {r.code}: {trim(r.stdout)} {trim(r.stderr)}"); exit(1); }
res = json_parse(r.stdout).result;
println(f"lmr at {dsl_cli(p)[0]}: {res.checks} checks passed, root {res.values.root}");
println("Install-and-run passed.");
