// access: write (build/dsl/tut-pacf-order.dslb)
// Topic: identifying the AR order from the PACF and from AIC (after: R ?pacf, ?ar, the Box-Jenkins identification step)
// What it does: one _dsl_ chunk simulates an AR(2) process with arima_sim, prints the ACF and PACF with the
//   1.96/sqrt(n) band, fits AR(1), AR(2) and AR(3) by maximum likelihood and prints their AIC, then checks that the PACF
//   is outside the band at lags 1-2 and inside the plain 1.96/sqrt(n) band at lags 3-8, that AIC picks order 2, that the
//   AR(2) coefficients are within 3 SE of the generating values, that the theoretical lag-1 ACF phi1/(1-phi2) matches
//   the sample ACF, that ACF(0) is 1 and that the innovation variance is within 0.25 of 1. Same checks as
//   examples/tut-pacf-order.lms.
// Data: 400 values of x_t = 0.5 x_{t-1} + 0.3 x_{t-2} + N(0, 1), arima_sim with rng(2024) (the native generator, not R's
//   stream, so the series differs from the original's seed 2024).
// Usage: lmscript examples/dsl/tut-pacf-order.lms   (cwd = repository root; lmr on PATH or in build-native/bin)
import "lib/lmr.lms";

p = _dsl_ schema="../../native/schema/lmr.dsl.json";
let phi = parse_vec("0.5 0.3");
let n = 400;
let x = arima_sim(rng(2024), n, phi, vec(), 1.0);
let acf = x.acf(8);
let pacf = x.pacf(8);
let band = 1.96 / sqrt(float(n));
let rho1 = phi.at(0) / (1.0 - phi.at(1));
out.print(fmt("n=%d", n) + fmt("  band +-%.3f", band) + fmt("  theoretical ACF(1) = phi1/(1-phi2) = %.4f", rho1));
out.print("lag   acf      pacf     outside band?");
for (k in range(1, 9)) {
  let flag = "no";
  if (abs(pacf.at(k - 1)) > band) {
    flag = "yes";
  }
  out.print(fmt("%3d", k) + fmt("  %7.4f", acf.at(k)) + fmt("  %7.4f", pacf.at(k - 1)) + "  " + flag);
}
out.print("order  ar coefficients (SE)                      sigma2   loglik    AIC");
let aics = vec();
for (q in range(1, 4)) {
  let f = arima(q, 0, 0).method("ML").fit(x);
  aics.push(f.aic());
  let desc = "";
  for (j in range(0, q)) {
    desc = desc + fmt("%.3f ", f.estimate(j)) + fmt("(%.3f) ", f.se(j));
  }
  out.print(fmt("  %d    ", q) + fmt("%-40s", desc) + fmt(" %.4f", f.sigma2()) + fmt("  %8.2f", f.loglik()) + fmt("  %8.2f", f.aic()));
}
let ar2 = arima(2, 0, 0).method("ML").fit(x);

# Self-checks.
for (k in range(1, 3)) {
  out.check(abs(pacf.at(k - 1)) > band, fmt("PACF outside the band at lag %d", k));
}
for (k in range(3, 9)) {
  out.check(abs(pacf.at(k - 1)) <= band, fmt("PACF inside the band at lag %d", k));
}
out.check(aics.at(1) < aics.at(0) && aics.at(1) < aics.at(2), "AIC selects AR(2)");
for (j in range(0, 2)) {
  out.check(abs(ar2.estimate(j) - phi.at(j)) <= 3.0 * ar2.se(j), fmt("AR(2) coefficient %d within 3 SE of the truth", j + 1));
}
let rho1_hat = ar2.estimate(0) / (1.0 - ar2.estimate(1));
out.check(abs(acf.at(1) - rho1_hat) <= 0.05, "lag-1 ACF within 0.05 of the fitted phi1/(1-phi2)");
out.check(abs(acf.at(1) - rho1) <= 0.15, "lag-1 ACF within 0.15 of the generating phi1/(1-phi2)");
out.check(acf.at(0) == 1.0, "ACF(0) is 1");
out.check(abs(ar2.sigma2() - 1.0) <= 0.25, "AR(2) innovation variance within 0.25 of 1");
out.set("aic", aics);
out.set("ar1", ar2.estimate(0));
out.set("ar2", ar2.estimate(1));
out.set("acf1", acf.at(1));
out.set("rho1_hat", rho1_hat);
out.set("rho1", rho1);
end _dsl_

v = lmr.check(lmr.run(p, "tut-pacf-order"));
println(sprintf("Checks passed: PACF cuts off after lag 2; AIC %.2f < %.2f, %.2f; ar1=%.3f ar2=%.3f within 3 SE of (0.5, 0.3); ACF(1)=%.3f vs fitted %.3f (generating %.3f).", v.aic[1], v.aic[0], v.aic[2], v.ar1, v.ar2, v.acf1, v.rho1_hat, v.rho1));
