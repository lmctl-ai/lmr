// access: write (build/dsl/tut-lm.dslb)
// Topic: multiple regression with a coefficient table and residual diagnostics (after: R ?lm, ?summary.lm, ?confint)
// What it does: one _dsl_ chunk fits mpg ~ weight + power from examples/data/tut-vehicles.csv with the native lm, prints
//   the coefficient table with t intervals, checks that the generating parameters lie inside the intervals, that the
//   residuals sum to zero and reproduce sigma and R^2, that they pass Shapiro-Wilk, and that a collinear copy of weight is
//   reported as aliased with the rank unchanged. Same checks as examples/tut-lm.lms, but every step runs inside one
//   lmr process: no R, no per-call JSON round trip.
// Data: examples/data/tut-vehicles.csv (see examples/tut-lm.lms for the generating model; power is not identifiable).
// Usage: lmscript examples/dsl/tut-lm.lms   (cwd = repository root; lmr on PATH or in build-native/bin)
import "lib/lmr.lms";

p = _dsl_ schema="../../native/schema/lmr.dsl.json";
let d = read_csv("examples/data/tut-vehicles.csv");
let fit = lm(d, "mpg ~ weight + power");
out.print(fmt("n=%d", fit.n()) + fmt("  rank=%d", fit.rank()) + fmt("  df=%d", fit.df_residual()) + fmt("  sigma=%.4f (true 1.2)", fit.sigma()) + fmt("  R^2=%.4f", fit.r_squared()));
out.print(fit.coef_table());
out.print("term          95% CI");
for (i in range(0, fit.n_coef())) {
  out.print(fmt("%-12s", fit.name(i)) + fmt("  [%.4f, ", fit.conf_low(i, 0.95)) + fmt("%.4f]", fit.conf_high(i, 0.95)));
}
# Self-check 1: every generating parameter lies inside its 95% interval.
fn covers(m: Lm, term: string, truth: float) -> bool {
  return m.conf_low(term, 0.95) <= truth && truth <= m.conf_high(term, 0.95);
}
out.check(covers(fit, "(Intercept)", 42.0), "true intercept 42 inside its 95% interval");
out.check(covers(fit, "weight", -5.0), "true weight slope -5 inside its 95% interval");
out.check(covers(fit, "power", -0.015), "true power slope -0.015 inside its 95% interval");
# Self-check 2: residuals sum to zero, sigma^2 = SSR / df, R^2 = 1 - SSR / SST.
let e = fit.residuals();
let ssr = e.dot(e);
let yc = d.col("mpg") - d.col("mpg").mean();
out.check(abs(e.sum()) < 0.000001, "residuals sum to zero");
out.check(abs(sqrt(ssr / float(fit.df_residual())) - fit.sigma()) < 0.000001, "sigma = sqrt(SSR / df)");
out.check(abs(1.0 - ssr / yc.dot(yc) - fit.r_squared()) < 0.000001, "R^2 = 1 - SSR / SST");
# Self-check 3: sigma within 25% of 1.2, and the residuals look normal.
out.check(abs(fit.sigma() - 1.2) < 0.3, "sigma within 25% of the generating 1.2");
let sw = test("shapiro").x(e).run();
out.print(fmt("Shapiro-Wilk on the residuals: W=%.4f", sw.statistic()) + fmt(", p=%.3f", sw.p_value()));
out.check(sw.p_value() > 0.01, "residuals pass Shapiro-Wilk at 1%");
# Self-check 4: an exact linear copy of weight is aliased; the rank stays 3 and the other estimates are unchanged.
let d2 = d.select("mpg,weight,power").set("twice", d.col("weight") * 2.0);
let alias = lm(d2, "mpg ~ weight + power + twice");
out.print(fmt("with twice = 2*weight: rank=%d", alias.rank()) + "  aliased(twice)=" + str(alias.aliased("twice")));
out.check(alias.rank() == 3 && alias.aliased("twice"), "collinear term reported as aliased");
for (i in range(0, 3)) {
  out.check(abs(alias.estimate(i) - fit.estimate(i)) < 0.000001, "aliased refit keeps " + fit.name(i));
}
out.set("estimates", fit.estimates());
out.set("sigma", fit.sigma());
out.set("r_squared", fit.r_squared());
end _dsl_

values = lmr.check(lmr.run(p, "tut-lm"));
println(sprintf("Checks passed: truth inside every 95%% CI; sigma=%.4f; R^2=%.4f; aliasing detected.", values.sigma, values.r_squared));
