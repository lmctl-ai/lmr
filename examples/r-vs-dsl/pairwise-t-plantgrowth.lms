// R vs lmr: pairwise comparisons after a one-way ANOVA (PlantGrowth). pairwise.t.test uses the pooled SD of all three
// groups (27 df) and adjusts the three p values by Holm's method by default.
// R:   pairwise.t.test(weight, group); ... p.adjust.method = "bonferroni"; ... p.adjust.method = "none"
// lmr: the pooled SD is the one-way model's sigma; each t uses it, and Holm's step-down adjustment is
//   p_(i) = max over j <= i of min(1, (m - j + 1) p_(j)) on the sorted p values.
// Compared in R's order: trt1-ctrl, trt2-ctrl, trt2-trt1.
// Usage: lmscript examples/r-vs-dsl/pairwise-t-plantgrowth.lms   (cwd = repository root)
import "../dsl/lib/lmr.lms";
import "lib/compare.lms";

p = _lmcode_ schema="../../native/schema/lmr.dsl.json";
let d = read_csv("examples/r-vs-dsl/data/PlantGrowth.csv");
let g = d.text("group");
let y = d.col("weight");
let levels = str_split("ctrl,trt1,trt2", ",");
let means = vec();
let ns = vec();
let t1 = vec();
let t2 = vec();
for (k in range(0, 3)) {
  let mask = vec();
  for (i in range(0, g.len())) {
    if (g.at(i) == levels.at(k)) { mask.push(1.0); } else { mask.push(0.0); }
  }
  if (k == 1) { t1 = mask; }
  if (k == 2) { t2 = mask; }
  means.push(y.where(mask).mean());
  ns.push(mask.sum());
}
d.set("trt1", t1).set("trt2", t2);
let fit = lm(d, "weight ~ trt1 + trt2");
let s = fit.sigma();
let df = float(fit.df_residual());
let ia = parse_vec("1 2 2");
let ib = parse_vec("0 0 1");
let raw = vec();
for (k in range(0, 3)) {
  let a = int(ia.at(k));
  let b = int(ib.at(k));
  let t = (means.at(a) - means.at(b)) / (s * sqrt(1.0 / ns.at(a) + 1.0 / ns.at(b)));
  raw.push(2.0 * t_dist(df).p_upper(abs(t)));
}
let o = raw.order();
let holm = zeros(3);
let run = 0.0;
for (j in range(0, 3)) {
  let k = int(o.at(j));
  run = max(run, min(1.0, float(3 - j) * raw.at(k)));
  holm.set(k, run);
}
let bonf = vec();
for (k in range(0, 3)) {
  bonf.push(min(1.0, 3.0 * raw.at(k)));
}
out.print("Holm-adjusted p (trt1-ctrl, trt2-ctrl, trt2-trt1): " + holm.format("%.4f", ", "));
out.set("holm", holm);
out.set("bonferroni", bonf);
out.set("unadjusted", raw);
end _lmcode_

got = lmr.check(lmr.run(p, "rvd-pairwise-t-plantgrowth"));
compare.finish("pairwise-t-plantgrowth", compare.report("pairwise-t-plantgrowth", got, "examples/r-vs-dsl/expected/pairwise-t-plantgrowth.json", 0.000000000001, {}));
