// R vs lmr: the examples of ?integrate, ?uniroot and ?optimize. Normal probabilities over [-1.96, 1.96] and the
// whole real line, the improper integral of 1/((x+1) sqrt(x)) over (0, Inf) (equal to pi), the root of x - 1/3 on
// [0, 1] and the minimum of (x - 1/3)^2, both with tol = 0.0001.
// R:   integrate(dnorm, -1.96, 1.96); integrate(dnorm, -Inf, Inf); integrate(function(x) 1/((x+1)*sqrt(x)), 0, Inf);
//      uniroot(function(x, a) x - a, c(0, 1), tol = 0.0001, a = 1/3); optimize(function(x, a) (x - a)^2, c(0, 1), ...)
// Usage: lmscript examples/r-vs-dsl/integrate-roots.lms   (cwd = repository root)
import "../dsl/lib/lmr.lms";
import "lib/compare.lms";

p = _dsl_ schema="../../native/schema/lmr.dsl.json";
let i1 = integrate(-1.96, 1.96);
while (i1.next()) {
  i1.tell(norm().d(i1.x()));
}
let i2 = integrate(-inf(), inf());
while (i2.next()) {
  i2.tell(norm().d(i2.x()));
}
let i3 = integrate(0.0, inf());
while (i3.next()) {
  let x = i3.x();
  i3.tell(1.0 / ((x + 1.0) * sqrt(x)));
}
let a = 1.0 / 3.0;
let u = uniroot(0.0, 1.0).tol(0.0001);
while (u.next()) {
  u.tell(u.x() - a);
}
let o = optimize(0.0, 1.0).tol(0.0001);
while (o.next()) {
  o.tell(pow(o.x() - a, 2.0));
}
out.print(fmt("integral of 1/((x+1) sqrt(x)) over (0, Inf) = %.12f", i3.value()) + fmt(" with absolute error < %.2g", i3.abs_error()));
out.set("normal_95", i1.value());
out.set("normal_all", i2.value());
out.set("improper_pi", i3.value());
out.set("improper_abs_error", i3.abs_error());
out.set("uniroot_root", u.root());
out.set("uniroot_iter", u.iter());
out.set("optimize_minimum", o.argmin());
out.set("optimize_objective", o.objective());
end _dsl_

got = lmr.check(lmr.run(p, "rvd-integrate-roots"));
compare.finish("integrate-roots", compare.report("integrate-roots", got, "examples/r-vs-dsl/expected/integrate-roots.json", 0.000000000001, {}));
