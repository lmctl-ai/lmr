// R vs lmr: tests for blocked and paired designs from the R help pages. Friedman on the RoundingTimes data
// (?friedman.test: 22 players, 3 methods of rounding first base), Quade on dataFreq (?quade.test) and McNemar on the
// Performance table (?mcnemar.test), with and without the continuity correction.
// R:   friedman.test(RoundingTimes); quade.test(dataFreq); mcnemar.test(Performance[, correct = FALSE])
// Usage: lmscript examples/r-vs-dsl/block-paired-tests.lms   (cwd = repository root)
import "../dsl/lib/lmr.lms";
import "lib/compare.lms";

p = _dsl_ schema="../../native/schema/lmr.dsl.json";
let rounding = parse_vec("5.40 5.50 5.55 5.85 5.70 5.75 5.20 5.60 5.50 5.55 5.50 5.40 5.90 5.85 5.70 5.45 5.55 5.60 5.40 5.40 5.35 5.45 5.50 5.35 5.25 5.15 5.00 5.85 5.80 5.70 5.25 5.20 5.10 5.65 5.55 5.45 5.60 5.35 5.45 5.05 5.00 4.95 5.50 5.50 5.40 5.45 5.55 5.50 5.55 5.55 5.35 5.45 5.50 5.55 5.50 5.45 5.25 5.65 5.60 5.40 5.70 5.65 5.55 6.30 6.30 6.25");
let fr = test("friedman").table(rounding, 22, true).run();
let freq = parse_vec("5 4 7 10 12 1 3 1 0 2 16 12 22 22 35 5 4 3 5 4 10 9 7 13 10 19 18 28 37 58 10 7 6 8 7");
let qu = test("quade").table(freq, 7, true).run();
let perf = parse_vec("794 86 150 570");
let mc = test("mcnemar").table(perf, 2, false).run();
let mc0 = test("mcnemar").table(perf, 2, false).correct(false).run();
out.print(fr.summary());
out.print(qu.summary());
out.print(mc.summary());
out.set("friedman_chi2", fr.statistic());
out.set("friedman_df", fr.df());
out.set("friedman_p", fr.p_value());
out.set("quade_f", qu.statistic());
out.set("quade_df", vec().push(qu.param("num df")).push(qu.param("denom df")));
out.set("quade_p", qu.p_value());
out.set("mcnemar_chi2", mc.statistic());
out.set("mcnemar_p", mc.p_value());
out.set("mcnemar_uncorrected", mc0.statistic());
out.set("mcnemar_uncorrected_p", mc0.p_value());
end _dsl_

got = lmr.check(lmr.run(p, "rvd-block-paired-tests"));
compare.finish("block-paired-tests", compare.report("block-paired-tests", got, "examples/r-vs-dsl/expected/block-paired-tests.json", 0.000000001, {}));
