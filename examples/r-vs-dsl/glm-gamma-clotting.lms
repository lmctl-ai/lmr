// R vs lmr: the Gamma example of ?glm (McCullagh & Nelder 1989, p. 300): blood clotting time against log plasma
// concentration for two lots of thromboplastin, with the canonical inverse link.
// R:   glm(lot1 ~ log(u), data = clotting, family = Gamma); glm(lot2 ~ log(u), data = clotting, family = Gamma)
// Compared: coefficients, standard errors and p values (which use the estimated dispersion), the dispersion,
//   deviance and AIC.
// Usage: lmscript examples/r-vs-dsl/glm-gamma-clotting.lms   (cwd = repository root)
import "../dsl/lib/lmr.lms";
import "lib/compare.lms";

p = _dsl_ schema="../../native/schema/lmr.dsl.json";
let d = frame().set("u", parse_vec("5 10 15 20 30 40 60 80 100"))
  .set("lot1", parse_vec("118 58 42 35 27 25 21 19 18")).set("lot2", parse_vec("69 35 26 21 18 16 13 12 12"));
let f1 = glm(d, "lot1 ~ log(u)", "Gamma");
let f2 = glm(d, "lot2 ~ log(u)", "Gamma");
out.print(f1.coef_table());
let se = vec();
let pv = vec();
for (i in range(0, f1.n_coef())) {
  se.push(f1.se(i));
  pv.push(f1.p_value(i));
}
out.set("lot1_estimate", f1.estimates());
out.set("lot1_std_error", se);
out.set("lot1_p_value", pv);
out.set("lot1_dispersion", f1.dispersion());
out.set("lot1_deviance", f1.deviance());
out.set("lot1_aic", f1.aic());
out.set("lot2_estimate", f2.estimates());
out.set("lot2_dispersion", f2.dispersion());
out.set("lot2_aic", f2.aic());
end _dsl_

got = lmr.check(lmr.run(p, "rvd-glm-gamma-clotting"));
compare.finish("glm-gamma-clotting", compare.report("glm-gamma-clotting", got, "examples/r-vs-dsl/expected/glm-gamma-clotting.json", 0.000000000001, {}));
