// R vs lmr: the Poisson example of ?glm (Dobson 1990, Table 2.2): nine counts by outcome and treatment.
// R:   counts <- c(18,17,15,20,10,20,25,13,12); outcome <- gl(3,1,9); treatment <- gl(3,3);
//      glm(counts ~ outcome + treatment, family = poisson())
// lmr: R's treatment contrasts are written out as dummies outcome2, outcome3, treatment2 and treatment3.
// Compared: coefficients, standard errors, z and p values, deviances, AIC, fitted values and deviance residuals.
// Usage: lmscript examples/r-vs-dsl/glm-dobson-poisson.lms   (cwd = repository root)
import "../dsl/lib/lmr.lms";
import "lib/compare.lms";

p = _lmcode_ schema="../../native/schema/lmr.dsl.json";
let d = frame().set("counts", parse_vec("18 17 15 20 10 20 25 13 12"))
  .set("outcome2", parse_vec("0 1 0 0 1 0 0 1 0")).set("outcome3", parse_vec("0 0 1 0 0 1 0 0 1"))
  .set("treatment2", parse_vec("0 0 0 1 1 1 0 0 0")).set("treatment3", parse_vec("0 0 0 0 0 0 1 1 1"));
let fit = glm(d, "counts ~ outcome2 + outcome3 + treatment2 + treatment3", "poisson");
out.print(fit.coef_table());
let se = vec();
let zv = vec();
let pv = vec();
for (i in range(0, fit.n_coef())) {
  se.push(fit.se(i));
  zv.push(fit.statistic(i));
  pv.push(fit.p_value(i));
}
out.set("estimate", fit.estimates());
out.set("std_error", se);
out.set("z_value", zv);
out.set("p_value", pv);
out.set("deviance", fit.deviance());
out.set("null_deviance", fit.null_deviance());
out.set("aic", fit.aic());
out.set("fitted", fit.fitted());
out.set("deviance_residuals", fit.residuals("deviance"));
end _lmcode_

got = lmr.check(lmr.run(p, "rvd-glm-dobson-poisson"));
compare.finish("glm-dobson-poisson", compare.report("glm-dobson-poisson", got, "examples/r-vs-dsl/expected/glm-dobson-poisson.json", 0.000000000001, {}));
