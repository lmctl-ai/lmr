// R vs lmr: sample autocorrelation and partial autocorrelation functions of lh and of the Nile flow series.
// R:   acf(lh, plot = FALSE); pacf(lh, plot = FALSE); acf(Nile, lag.max = 20); pacf(Nile, lag.max = 20)
// lh has 48 points, so R's default lag.max is floor(10 * log10(48)) = 16; acf includes lag 0, pacf starts at lag 1.
// Usage: lmscript examples/r-vs-dsl/acf-pacf.lms   (cwd = repository root)
import "../dsl/lib/lmr.lms";
import "lib/compare.lms";

p = _dsl_ schema="../../native/schema/lmr.dsl.json";
let lh = read_csv("examples/r-vs-dsl/data/lh.csv").col("value");
let nile = read_csv("examples/r-vs-dsl/data/Nile.csv").col("value");
out.print("lh acf lags 1-5: " + lh.acf(16).slice(1, 6).format("%.4f", ", "));
out.set("lh_acf", lh.acf(16));
out.set("lh_pacf", lh.pacf(16));
out.set("nile_acf_20", nile.acf(20));
out.set("nile_pacf_20", nile.pacf(20));
end _dsl_

got = lmr.check(lmr.run(p, "rvd-acf-pacf"));
compare.finish("acf-pacf", compare.report("acf-pacf", got, "examples/r-vs-dsl/expected/acf-pacf.json", 0.000000000001, {}));
