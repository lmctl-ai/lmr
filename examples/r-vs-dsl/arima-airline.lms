// R vs lmr: the airline model, seasonal ARIMA(0,1,1)(0,1,1)[12] on log(AirPassengers), with a 12-month forecast.
// R:   fit <- arima(log(AirPassengers), order = c(0, 1, 1), seasonal = list(order = c(0, 1, 1), period = 12));
//      predict(fit, n.ahead = 12)
// Compared: the two MA coefficients and their standard errors, sigma^2, log-likelihood, AIC and the forecasts on the
//   log and passenger scales with their standard errors. The two optimisers stop at slightly different points of a
//   flat likelihood, so the MA coefficients agree to about 4e-7, forecasts to about 5e-8 and the log-likelihood to
//   1e-12.
// Usage: lmscript examples/r-vs-dsl/arima-airline.lms   (cwd = repository root)
import "../dsl/lib/lmr.lms";
import "lib/compare.lms";

p = _dsl_ schema="../../native/schema/lmr.dsl.json";
let x = read_csv("examples/r-vs-dsl/data/AirPassengers.csv").col("value").log();
let fit = arima(0, 1, 1).seasonal(0, 1, 1, 12).fit(x);
let fc = fit.forecast(12);
let c = vec();
let s = vec();
for (i in range(0, fit.n_coef())) {
  c.push(fit.estimate(i));
  s.push(fit.se(i));
}
out.print("ma1, sma1 = " + c.format("%.5f", ", ") + fmt("  sigma^2 %.6f", fit.sigma2()) + fmt("  aic %.3f", fit.aic()));
out.set("coef", c);
out.set("se", s);
out.set("sigma2", fit.sigma2());
out.set("loglik", fit.loglik());
out.set("aic", fit.aic());
out.set("forecast_log", fc.mean());
out.set("forecast_se", fc.se());
out.set("forecast_passengers", fc.mean().exp());
end _dsl_

got = lmr.check(lmr.run(p, "rvd-arima-airline"));
compare.finish("arima-airline", compare.report("arima-airline", got, "examples/r-vs-dsl/expected/arima-airline.json", 0.000002, {}));
