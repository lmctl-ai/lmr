#!/bin/sh
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
uid=$(id -u)
gid=$(id -g)
cwd=$(pwd -P)
home=$(CDPATH= cd -- "${HOME:-/}" 2>/dev/null && pwd -P || printf /)
case "$cwd" in
  /|"$home") printf '{"success":false,"error":{"code":"INVALID_REQUEST","message":"rcli requires a working directory below HOME","data":{}}}\n'; exit 2 ;;
  "$home"/*) ;;
  *) printf '{"success":false,"error":{"code":"INVALID_REQUEST","message":"rcli requires a working directory below HOME","data":{}}}\n'; exit 2 ;;
esac
out=$(mktemp)
err=$(mktemp)
tmpdir="$cwd/.rcli-tmp"
mkdir -p "$tmpdir"
cleanup() {
  [ -z "${out:-}" ] || rm -f "$out"
  [ -z "${err:-}" ] || rm -f "$err"
  rmdir "$tmpdir" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
set +e
docker run --rm --network=none --cpus=2 --memory=5g -u "$uid:$gid" \
  -e TMPDIR="$tmpdir" ${RCLI_TIMEOUT_S:+-e RCLI_TIMEOUT_S} \
  --mount "type=bind,src=$cwd,dst=$cwd" -w "$cwd" rcli:runtime "$@" >"$out" 2>"$err"
rc=$?
set -e
if grep -Eiq '(^docker:|Error response from daemon|Cannot connect to the Docker daemon|Unable to find image|pull access denied|error during connect|docker: not found)' "$err"; then
  [ ! -s "$out" ] || cat "$out"
  [ ! -s "$err" ] || cat "$err" >&2
  printf '{"success":false,"error":{"code":"SERVICE_UNAVAILABLE","message":"rcli container failed to start","data":{"docker_exit":%s}}}\n' "$rc"
  rc=8
elif { [ "$rc" -ge 128 ] || { [ ! -s "$out" ] && [ "$rc" -ne 0 ]; }; }; then
  [ ! -s "$err" ] || cat "$err" >&2
  printf '{"success":false,"error":{"code":"INTERNAL_ERROR","message":"rcli exited without a result","data":{"tool_code":"TOOL_CRASH","exit":%s}}}\n' "$rc"
  rc=1
else
  [ ! -s "$out" ] || cat "$out"
  [ ! -s "$err" ] || cat "$err" >&2
fi
exit "$rc"
