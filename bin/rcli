#!/bin/sh
set -eu
uid=$(id -u)
gid=$(id -g)
# Keep pwd's trailing newlines so control bytes cannot disappear in command substitution.
cwd=$(pwd -P; printf /)
cwd=${cwd%/}
cwd=${cwd%?}
invalid_cwd() {
  printf '{"success":false,"error":{"code":"INVALID_REQUEST","message":"rcli requires a directory below HOME without comma, quote, equals or control characters","data":{}}}\n'
  exit 2
}
case "$cwd" in *[,\"=]*) invalid_cwd;; esac
if [ "$(printf '%s' "$cwd" | LC_ALL=C tr -d '[:cntrl:]')" != "$cwd" ]; then invalid_cwd; fi
home=$(CDPATH= cd -- "${HOME:-/}" 2>/dev/null && pwd -P || printf /)
case "$cwd" in
  /|"$home") invalid_cwd ;;
  "$home"/*) ;;
  *) invalid_cwd ;;
esac
capture_dir=$(mktemp -d "${TMPDIR:-/tmp}/rcli-shim.XXXXXX")
out="$capture_dir/out"
err="$capture_dir/err"
workspace_tmp=$(mktemp -d "$cwd/.rcli-tmp.XXXXXX")
container_name="rcli-$uid-$$-$(basename "$capture_dir")"
docker_pid=
cleanup() { rm -rf -- "$capture_dir" "$workspace_tmp"; }
cancel() {
  code=$1
  trap '' HUP INT TERM
  docker kill --signal TERM "$container_name" >/dev/null 2>&1 || true
  docker rm --force "$container_name" >/dev/null 2>&1 || true
  if [ -n "$docker_pid" ]; then kill -TERM "$docker_pid" 2>/dev/null || true; wait "$docker_pid" 2>/dev/null || true; fi
  docker rm --force "$container_name" >/dev/null 2>&1 || true
  exit "$code"
}
trap cleanup EXIT
trap 'cancel 129' HUP
trap 'cancel 130' INT
trap 'cancel 143' TERM
set +e
docker run --rm --pull=never --init --name "$container_name" --network=none --cpus=2 --memory=5g -u "$uid:$gid" \
  -e TMPDIR="$workspace_tmp" -e RCLI_READONLY -e RCLI_DRYRUN ${RCLI_TIMEOUT_S:+-e RCLI_TIMEOUT_S} \
  --mount "type=bind,src=$cwd,dst=$cwd" -w "$cwd" rcli:runtime "$@" >"$out" 2>"$err" &
docker_pid=$!
wait "$docker_pid"
rc=$?
set -e
if grep -Eiq '(^docker:|Error response from daemon|Cannot connect to the Docker daemon|Unable to find image|pull access denied|error during connect|docker: not found)' "$err"; then
  [ ! -s "$out" ] || cat "$out"
  [ ! -s "$err" ] || cat "$err" >&2
  printf '{"success":false,"error":{"code":"SERVICE_UNAVAILABLE","message":"rcli container unavailable; build locally with the runtime recipe","data":{"docker_exit":%s}}}\n' "$rc"
  rc=8
elif { [ "$rc" -ge 128 ] || { [ ! -s "$out" ] && [ "$rc" -ne 0 ]; }; }; then
  [ ! -s "$err" ] || cat "$err" >&2
  printf '{"success":false,"error":{"code":"INTERNAL_ERROR","message":"rcli exited without a result","data":{"tool_code":"TOOL_CRASH","exit":%s}}}\n' "$rc"
  rc=1
else
  [ ! -s "$out" ] || cat "$out"
  [ ! -s "$err" ] || cat "$err" >&2
fi

exit "$rc"
